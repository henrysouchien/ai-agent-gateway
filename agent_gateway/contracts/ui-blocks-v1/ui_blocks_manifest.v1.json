  "data_sources": {
    "$defs": {
      "agent_visible_id": {
        "enum": [
          "positions",
          "risk-score",
          "risk-analysis",
          "performance",
          "factor-analysis",
          "portfolio-summary"
        ]
      }
    },
    "sources": {
      "positions": {
        "status": "agent-visible",
        "label": "Portfolio Positions",
        "params": {
          "portfolioId": {
            "type": "string",
            "required": false,
            "description": "Portfolio identifier override. Defaults to the active portfolio."
          }
        },
        "fields": {
          "holdings": {
            "type": "array",
            "description": "Current portfolio holdings.",
            "items": {
              "ticker": {
                "type": "string"
              },
              "shares": {
                "type": "number"
              },
              "market_value": {
                "type": "number"
              },
              "security_name": {
                "type": "string"
              }
            }
          },
          "totalPortfolioValue": {
            "type": "number",
            "description": "Total portfolio market value."
          },
          "statementDate": {
            "type": "date",
            "description": "Statement or snapshot date for holdings."
          },
          "accountType": {
            "type": "string",
            "description": "Account type associated with the portfolio."
          }
        }
      },
      "risk-score": {
        "status": "agent-visible",
        "label": "Portfolio Risk Score",
        "params": {
          "portfolioId": {
            "type": "string",
            "required": false,
            "description": "Portfolio identifier override. Defaults to the active portfolio."
          }
        },
        "fields": {
          "overall_risk_score": {
            "type": "number",
            "description": "Overall risk score from 0 to 100; higher is better."
          },
          "component_scores": {
            "type": "array",
            "description": "Risk score breakdown by component.",
            "items": {
              "name": {
                "type": "string"
              },
              "score": {
                "type": "number"
              },
              "maxScore": {
                "type": "number"
              }
            }
          },
          "risk_category": {
            "type": "string",
            "description": "Risk category label."
          },
          "recommendations": {
            "type": "array",
            "description": "Risk mitigation recommendations.",
            "items": {
              "$value": {
                "type": "string"
              }
            }
          }
        }
      },
      "risk-analysis": {
        "status": "agent-visible",
        "label": "Portfolio Risk Analysis",
        "params": {
          "portfolioId": {
            "type": "string",
            "required": false,
            "description": "Portfolio identifier override. Defaults to the active portfolio."
          },
          "performancePeriod": {
            "type": "string",
            "required": false,
            "default": "1M",
            "description": "Performance lookback period (for example: 1M, 3M, 1Y)."
          }
        },
        "fields": {
          "portfolio_summary": {
            "type": "object",
            "description": "Portfolio-level summary metrics."
          },
          "risk_metrics": {
            "type": "object",
            "description": "Aggregate portfolio risk metrics."
          },
          "variance_decomposition": {
            "type": "object",
            "description": "Factor vs idiosyncratic variance split."
          },
          "factor_exposures": {
            "type": "object",
            "description": "Portfolio factor exposure breakdown."
          },
          "correlation_matrix": {
            "type": "object",
            "description": "Correlation matrix between assets."
          }
        }
      },
      "performance": {
        "status": "agent-visible",
        "label": "Portfolio Performance",
        "params": {
          "portfolioId": {
            "type": "string",
            "required": false,
            "description": "Portfolio identifier override. Defaults to the active portfolio."
          },
          "benchmarkTicker": {
            "type": "string",
            "required": false,
            "description": "Benchmark ticker override for performance comparison."
          },
          "includeAttribution": {
            "type": "boolean",
            "required": false,
            "default": true,
            "description": "Whether to include full attribution tables in the performance payload."
          },
          "mode": {
            "type": "string",
            "enum": [
              "auto",
              "hypothetical",
              "realized"
            ],
            "required": false,
            "default": "auto",
            "description": "Performance mode override."
          }
        },
        "fields": {
          "period": {
            "type": "object",
            "description": "Analysis period metadata."
          },
          "returns": {
            "type": "object",
            "description": "Return metrics."
          },
          "risk": {
            "type": "object",
            "description": "Risk metrics for the period."
          },
          "performanceTimeSeries": {
            "type": "array",
            "description": "Performance time-series points.",
            "items": {
              "date": {
                "type": "string"
              },
              "portfolioValue": {
                "type": "number"
              },
              "benchmarkValue": {
                "type": "number"
              },
              "portfolioCumReturn": {
                "type": "number"
              },
              "benchmarkCumReturn": {
                "type": "number"
              },
              "activeReturn": {
                "type": "number"
              },
              "rollingSharpe": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "rollingVol": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "drawdown": {
                "type": "number"
              }
            }
          }
        }
      },
      "factor-analysis": {
        "status": "agent-visible",
        "label": "Factor Analysis",
        "params": {
          "portfolioId": {
            "type": "string",
            "required": false,
            "description": "Portfolio identifier override. Defaults to the active portfolio."
          }
        },
        "presets": {
          "factor-analysis-chart": {
            "block": "sdk:chart-panel",
            "field": "factor_exposures",
            "xKey": "factor",
            "yKeys": [
              "exposure"
            ],
            "chartType": "bar"
          }
        },
        "fields": {
          "factor_exposures": {
            "type": "object",
            "description": "Portfolio factor exposure values."
          },
          "weighted_factor_var": {
            "type": "object",
            "description": "Factor variance contributions."
          },
          "variance_decomposition": {
            "type": "object",
            "description": "Variance decomposition by factor classes."
          }
        }
      },
      "portfolio-summary": {
        "status": "agent-visible",
        "label": "Portfolio Summary",
        "params": {
          "portfolioId": {
            "type": "string",
            "required": false,
            "description": "Portfolio identifier override. Defaults to the active portfolio."
          },
          "includeEnrichment": {
            "type": "boolean",
            "required": false,
            "default": true,
            "description": "Whether to asynchronously enrich the summary with risk and performance data."
          }
        },
        "fields": {
          "summary": {
            "type": "object",
            "description": "Aggregated portfolio summary metrics."
          },
          "holdings": {
            "type": "array",
            "description": "Simplified holdings for overview display.",
            "items": {
              "id": {
                "type": "string"
              },
              "ticker": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "value": {
                "type": "number"
              },
              "shares": {
                "type": "number"
              },
              "isProxy": {
                "type": "boolean"
              },
              "weight": {
                "type": "number"
              },
              "type": {
                "type": "string",
                "optional": true
              },
              "totalReturn": {
                "type": "number",
                "optional": true
              },
              "factorBetas": {
                "type": "object"
              },
              "riskContributionPct": {
                "type": "number"
              },
              "beta": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "volatility": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "aiScore": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "alerts": {
                "type": "number"
              },
              "alertDetails": {
                "type": "array"
              },
              "trend": {
                "type": "array"
              },
              "dayChangePercent": {
                "type": "number",
                "optional": true
              }
            }
          }
        }
      },
      "positions-enriched": {
        "status": "excluded",
        "reason": "Not required by the v1 admitted views or checkpoint scenario."
      },
      "leverage-capacity": {
        "status": "excluded",
