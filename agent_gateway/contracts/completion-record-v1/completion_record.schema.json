{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hank.investments/contracts/completion-record-v1/completion_record.schema.json",
  "title": "completion_record v1",
  "description": "One JSON line per one-shot provider call made by a companion repo: what was sent and what came back. Day-sharded at <root>/<YYYY-MM-DD>.jsonl, append-only, keep_forever. Writers do not validate; the exporter validates and reports nonconforming rows.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type", "schema_version", "completion_id", "recorded_at", "started_at",
    "duration_ms", "source", "join", "model", "capture_level", "request", "response",
    "usage", "outcome"
  ],
  "$defs": {
    "nullableString": {"type": ["string", "null"]},
    "nullableCount": {"type": ["integer", "null"], "minimum": 0}
  },
  "properties": {
    "record_type": {"const": "completion"},
    "schema_version": {"const": 1},
    "completion_id": {"type": "string", "pattern": "^cmp_[0-9a-f]{32}$"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "started_at": {"type": "string", "format": "date-time"},
    "duration_ms": {"type": ["integer", "null"], "minimum": 0},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "call_site", "caller"],
      "properties": {
        "repo": {
          "description": "Writing repo (investment_tools, edgar_updater, risk_module); null when the writer is a shared helper whose root already names the repo.",
          "$ref": "#/$defs/nullableString"
        },
        "call_site": {
          "description": "Stable dotted id: CapabilityBind.capability_id for gateway-bound callers, edgar.<workload>.<transport> otherwise.",
          "type": "string",
          "minLength": 1
        },
        "caller": {"$ref": "#/$defs/nullableString"}
      }
    },
    "join": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id", "request_id", "group_id", "task_id", "trace_id", "user_id", "subject"],
      "properties": {
        "session_id": {"$ref": "#/$defs/nullableString"},
        "request_id": {"$ref": "#/$defs/nullableString"},
        "group_id": {"$ref": "#/$defs/nullableString"},
        "task_id": {"$ref": "#/$defs/nullableString"},
        "trace_id": {"$ref": "#/$defs/nullableString"},
        "user_id": {"$ref": "#/$defs/nullableString"},
        "subject": {"type": "object"}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "provider_reported_model", "capability_bind", "model_selection"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "provider_reported_model": {"$ref": "#/$defs/nullableString"},
        "capability_bind": {"type": ["object", "null"]},
        "model_selection": {"type": ["object", "null"]}
      }
    },
    "capture_level": {
      "description": "wire: exact SDK/HTTP body and response; stream: provider request params and raw content blocks; text: prompt/system/params and output text where a third-party library owns the wire call.",
      "enum": ["wire", "stream", "text"]
    },
    "request": {"type": "object"},
    "response": {"type": ["object", "null"]},
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "cache_read_tokens", "cache_creation_tokens", "reasoning_tokens"],
      "properties": {
        "input_tokens": {"$ref": "#/$defs/nullableCount"},
        "output_tokens": {"$ref": "#/$defs/nullableCount"},
        "cache_read_tokens": {"$ref": "#/$defs/nullableCount"},
        "cache_creation_tokens": {"$ref": "#/$defs/nullableCount"},
        "reasoning_tokens": {"$ref": "#/$defs/nullableCount"}
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "error_type", "error_message"],
      "properties": {
        "status": {"enum": ["ok", "error", "canceled"]},
        "error_type": {"$ref": "#/$defs/nullableString"},
        "error_message": {"$ref": "#/$defs/nullableString"}
      }
    }
  }
}
